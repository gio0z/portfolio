# Environment variables read by the portfolio server.
#
# Copy to .env and fill in. Never commit real values: .env is gitignored and
# this file is the only tracking-point, so keep every secret out of it.

# HTTP port the server listens on. Defaults to 8080 when unset.
PORT=8080
# Interface the server binds. Defaults to 0.0.0.0, which listens on every
# interface. Set 127.0.0.1 when a proxy or tunnel on the same host is the only
# intended client: the API includes the admin surface, and a host without a
# firewall would otherwise expose it to the whole LAN.
HOST=0.0.0.0

# Runtime environment. "development" or "test" relaxes admin auth (no secure
# cookies, dev approval verifier). Anything else, including the default, is
# treated as production and admin auth must be fully configured or the server
# refuses to start.
APP_ENV=development
# Alias for APP_ENV, read only when APP_ENV is unset.
# ENVIRONMENT=development

# GitHub admin login
# ---------------------------------------------------------------------------
# Only this GitHub account may sign in to the admin area. Defaults to gio0z.
ADMIN_ALLOWED_GITHUB_LOGIN=gio0z

# OAuth app used for admin sign-in (create under GitHub > Developer settings).
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=

# Key used to sign admin session cookies. Use a long random value, e.g. from
# `openssl rand -hex 32`. Changing it invalidates every existing session.
ADMIN_SESSION_SIGNING_KEY=

# Public origin the OAuth callback returns to (scheme + host, no trailing
# slash), e.g. https://example.com or http://localhost:8080.
ADMIN_PUBLIC_ORIGIN=

# Contact channel
# ---------------------------------------------------------------------------
# WhatsApp number served by GET /api/contact/whatsapp as
# https://wa.me/<digits>. Digits only, country code first, no plus sign or
# spaces (e.g. 6285156439303). Left unset, that endpoint returns 404, which is
# the safe default: the number then exists nowhere public.
CONTACT_WHATSAPP=

# Agent publishing (MCP bearer tokens)
# ---------------------------------------------------------------------------
# HMAC secret minting short-lived scoped agent tokens. At least 32 bytes,
# e.g. from `openssl rand -hex 32`. Required in production; MCP is disabled
# without it outside production.
MCP_TOKEN_SECRET=

# Publishing origins and storage
# ---------------------------------------------------------------------------
# Isolated sandboxed origin serving preview bundles (unlisted, noindex),
# e.g. https://previews.example.com.
PREVIEW_PUBLIC_ORIGIN=
# Public origin exposing published Lab projects, e.g. https://lab.example.com.
LAB_PUBLIC_ORIGIN=
# Public origin of the portfolio Design Lab catalog,
# e.g. https://example.com.
#
# This value is REQUIRED for the frontend build as well as at runtime: the
# Astro build uses it for every <link rel="canonical"> and for sitemap.xml, and
# refuses to build without it. A wrong canonical points search engines at a
# host you do not control, so the build fails closed instead of guessing.
# For a local build, use http://localhost:4321.
PORTFOLIO_PUBLIC_ORIGIN=
# Filesystem path of the SQLite publishing registry, e.g.
# /var/lib/portfolio/registry.sqlite (`:memory:` selects an ephemeral
# registry outside production).
REGISTRY_PATH=
# Filesystem root for content-addressed artifacts, preview bundles, and
# Lab/portfolio version paths, e.g. /data/portfolio-artifacts.
ARTIFACT_STORE_ROOT=

# Static frontend bundle served with SPA fallback. Overrides the default
# ./frontend/dist.
FRONTEND_DIST=
